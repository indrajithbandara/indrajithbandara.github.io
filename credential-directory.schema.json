{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transcriptDate", "lastSuccessfulSync", "publicCredentialCount", "otherPublicCredentialCount", "records"],
  "properties": {
    "schemaVersion": {"const": 1},
    "transcriptDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "lastSuccessfulSync": {"type": ["string", "null"]},
    "publicCredentialCount": {"type": ["integer", "null"], "minimum": 0},
    "otherPublicCredentialCount": {"type": ["integer", "null"], "minimum": 0},
    "records": {"type": "array", "items": {"$ref": "#/definitions/credential"}}
  },
  "definitions": {
    "nullableText": {"type": ["string", "null"]},
    "nullableDate": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "issuer", "authorizingOrganization", "issueDate", "expirationDate", "status", "badgeImage", "verificationUrl", "publicCredentialId", "domains", "domainClassification", "type", "description", "skills", "source", "lastSynchronized"],
      "properties": {
        "id": {"type": "string", "pattern": "^transcript-[a-f0-9]{24}$"},
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "authorizingOrganization": {"$ref": "#/definitions/nullableText"},
        "issueDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "expirationDate": {"$ref": "#/definitions/nullableDate"},
        "status": {"enum": ["active", "expired", "no-expiration", "unavailable"]},
        "badgeImage": {"type": ["string", "null"], "pattern": "^https://images\\.credly\\.com/"},
        "verificationUrl": {"type": ["string", "null"], "pattern": "^https://www\\.credly\\.com/badges/"},
        "publicCredentialId": {"type": ["string", "null"], "pattern": "^[a-f0-9-]{36}$"},
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["Cybersecurity", "Artificial Intelligence", "Generative AI", "Data Science and Analytics", "Computer Networking", "Cloud Computing", "DevOps", "Software Development", "Linux and Open Source", "IT Support", "Project Management", "Business and Professional Development", "Other Learning"]}},
        "domainClassification": {"const": "inferred"},
        "type": {"$ref": "#/definitions/nullableText"},
        "description": {"$ref": "#/definitions/nullableText"},
        "skills": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string", "minLength": 1},
        "lastSynchronized": {"$ref": "#/definitions/nullableText"}
      }
    }
  }
}
